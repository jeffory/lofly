{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lofly",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Keep the workers.dev URL alongside the custom domain; adding `routes`
  // silently disables it otherwise, which costs a useful debugging fallback.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Assets normally short-circuit the Worker. Only the pre-compressed
    // variants need to reach it, to be tagged with Content-Encoding; every
    // other path is served straight from the asset server, and the compressible
    // content types among them are compressed by Cloudflare itself.
    "run_worker_first": ["/data/*.br", "/wasm/*.br"]
  },
  // Custom domain. Wrangler creates the DNS record and certificate on the
  // jeffory.dev zone; the workers.dev URL keeps working alongside it.
  "routes": [
    { "pattern": "lofly.jeffory.dev", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
